# ==========================================
# Value Investing Terminal — Environment Configuration Template
# Copy this file to .env or .env.local and populate with your own credentials.
# NEVER commit your real .env file to version control.
# ==========================================

# GEMINI_API_KEY: Required for valuation synthesis and generative reasoning.
# Can also be entered dynamically via the terminal UI.
GEMINI_API_KEY=""

# FMP_API_KEY: Financial Modeling Prep API key for financial statements & autofill.
# Can also be entered dynamically in the terminal settings panel.
FMP_API_KEY=""

# STOCK_ANALYSIS_EMAIL & PASSWORD: (Optional) Used for automated transcript retrieval.
# Alternatively, provide a session cookie directly in the UI.
STOCK_ANALYSIS_EMAIL=""
STOCK_ANALYSIS_PASSWORD=""

# SEC EDGAR IDENTIFICATION: (Optional) SEC requires a user-agent contact string.
SEC_NAME="Analyst"
SEC_EMAIL="analyst@example.com"

# VITE_GOOGLE_CLIENT_ID: (Optional) Google OAuth Client ID for Google Docs export.
VITE_GOOGLE_CLIENT_ID=""

# APP_URL: (Optional) The host URL for OAuth callbacks or cloud container proxying.
APP_URL="http://localhost:3000"
